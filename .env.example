# =====================================================================
# ПОРТАЛ ИВИТШ КГУ — ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# Скопируйте файл: cp .env.example .env  — и заполните значения.
# Файл .env никогда не коммитится. Все секреты из старых версий репозитория считаются
# скомпрометированными: используйте только новые значения.
# =====================================================================

# --- Безопасность и JWT ---
# Обязательно, минимум 32 символа. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# true в продакшене (HTTPS). Браузеры принимают Secure-куки и на http://localhost.
COOKIE_SECURE=true
# Swagger UI (/docs). В продакшене держите выключенным.
DOCS_ENABLED=false

# --- База данных ---
# Docker Compose собирает DATABASE_URL для PostgreSQL из POSTGRES_* сам.
POSTGRES_DB=portal_db
POSTGRES_USER=portal_user
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Для локальной разработки без Docker:
DATABASE_URL=sqlite:///./portal.db
# Размер пула соединений на один процесс backend (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Главный администратор (вход «Сотрудник ИВИТШ») ---
# Логин не должен совпадать ни с одним логином ЭИОС.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- ЭИОС КГУ ---
EIOS_BASE_URL=https://eios.kosgos.ru/api
VERIFY_SSL=true

# --- GigaChat (чат-бот ВИТШик) ---
# «Ключ авторизации» из личного кабинета Сбера (base64 от client_id:client_secret).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat-2 (Lite), GigaChat-2-Pro или GigaChat-2-Max — список: python -m app.services.gigachat_check
GIGACHAT_MODEL=GigaChat-2
# Сколько запросов ключ выдерживает одновременно: 1 для физлиц, 10 для юрлиц. Остальные ждут очереди.
GIGACHAT_MAX_STREAMS=1
# Сертификаты Минцифры для GigaChat уже встроены (server/app/assets/certs/russian_trusted_ca.pem).
# Сюда — путь к дополнительному PEM, только если Минцифры выпустит новый сертификат раньше обновления портала.
GIGACHAT_CA_BUNDLE=

# --- Документы, которые готовит ВИТШик (объяснительная, заявление на пересдачу) ---
# Кому адресованы, в дательном падеже. DOCUMENT_ADDRESSEE_NAME=- оставит строку пустой для ручного заполнения.
DOCUMENT_ADDRESSEE_TITLE=Директору Высшей ИТ-школы КГУ
DOCUMENT_ADDRESSEE_NAME=А. С. Борисову

# Файлы к задачам и объявлениям объединений: папка на сервере (в Docker — том данных) и лимит размера.
# Пусто — папка uploads рядом с сервером. В git файлы не попадают.
UPLOAD_DIR=
MAX_UPLOAD_MB=10

# --- CORS ---
# SPA и API работают на одном домене, поэтому CORS не нужен. Указывайте здесь (через запятую)
# только дополнительные доверенные фронтенды на других доменах.
ALLOWED_ORIGINS=

# --- Фронтенд ---
# Оставьте пустым: SPA обращается к API на том же домене (/api).
VITE_API_URL=
