# Everything in one container: the SPA behind nginx and the backend on SQLite.
# Built and started by the docker-compose.yml in the repository root.
# Production (PostgreSQL, HTTPS) uses infrastructure/docker-compose.yml instead.

# --- Stage 1: build the React SPA ---
FROM node:22-alpine AS client
WORKDIR /app
COPY client/package*.json ./
RUN npm ci
COPY client ./
RUN npm run build

# --- Stage 2: backend + nginx ---
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/server \
    PIP_NO_CACHE_DIR=1 \
    DATABASE_URL=sqlite:////app/data/portal.db \
    COOKIE_SECURE=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/server
COPY server/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt
COPY server ./
COPY --from=client /app/dist /usr/share/nginx/html

COPY infrastructure/nginx/snippets /etc/nginx/snippets
COPY infrastructure/docker/standalone/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/docker/standalone/entrypoint.sh /usr/local/bin/portal-entrypoint

# The backend listens on localhost inside this container instead of the compose service "backend".
# sed also strips CRLF in case the repository was checked out on Windows with autocrlf.
RUN sed -i 's#http://backend:8000#http://127.0.0.1:8000#' /etc/nginx/snippets/proxy-backend.conf \
    && sed -i 's/\r$//' /usr/local/bin/portal-entrypoint \
    && chmod 755 /usr/local/bin/portal-entrypoint \
    && useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin portal \
    && mkdir -p /app/data && chown portal /app/data
USER portal

EXPOSE 8080
VOLUME /app/data

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/v1/health/ready', timeout=4)"

ENTRYPOINT ["portal-entrypoint"]
