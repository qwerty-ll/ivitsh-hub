FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/server \
    PIP_NO_CACHE_DIR=1

WORKDIR /app/server

# psycopg2-binary and bcrypt ship wheels, so no compiler toolchain is needed in the image.
COPY server/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY server ./

# Writable directory for an optional SQLite database (DATABASE_URL=sqlite:////app/data/portal.db).
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin portal \
    && mkdir -p /app/data && chown portal /app/data
USER portal

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/ready', timeout=4)"

# --proxy-headers makes request.client the real visitor IP (from nginx) for rate limiting.
# The backend port is not published outside the compose network, so trusting any proxy is safe here.
# uvicorn starts WEB_CONCURRENCY worker processes (1 if unset); more than one needs REDIS_URL and PostgreSQL.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
